# ─────────────────────────────────────────────────────────────────────────────
# Fitness Physique Classifier — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# On Vercel: use Vercel Postgres (neon-compatible) or Neon directly
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/fitness_classifier

# Vercel Postgres (set automatically when you add Vercel Postgres integration)
PGHOST=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGPORT=5432

# Node environment
NODE_ENV=production
